{
  "name": "iobroker.victron-bmv",
  "version": "0.0.3",
  "description": "Victron BMV battery monitor via VE.Direct text protocol",
  "author": {
    "name": "joerg",
    "email": "joerg.oss@gmx.de"
  },
  "homepage": "https://github.com/joergoss/ioBroker.victron-bmv",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ioBroker",
    "Victron",
    "BMV",
    "VE.Direct",
    "battery monitor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergoss/ioBroker.victron-bmv"
  },
  "dependencies": {
    "@iobroker/adapter-core": "~3.2.3",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@iobroker/testing": "^6.3.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^22.0.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "chai": "^4.5.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.4",
    "sinon": "^22.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "docs/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
    "test:package": "mocha test/package --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "release": "release-script"
  },
  "overrides": {
    "minimist": "1.2.8",
    "simple-get": "4.0.1",
    "tar-fs": "2.1.4",
    "mocha": {
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "bugs": {
    "url": "https://github.com/joergoss/ioBroker.victron-bmv/issues"
  },
  "readmeFilename": "README.md"
}
